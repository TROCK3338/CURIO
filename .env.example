# ============================================
# MindSpace Environment Variables
# Copy to .env in both apps/api and apps/web
# ============================================

# --------------------------------------------
# Required: Database (Turso)
# Get from: https://turso.tech → Create database → Show connection info
# --------------------------------------------
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------
# Required: AI (Google Gemini)
# Get from: https://aistudio.google.com/apikey
# Student plan gives 1,500 req/day free on Gemini 1.5 Flash
# --------------------------------------------
GEMINI_API_KEY=AIzaSy...

# --------------------------------------------
# Required: Cron Security
# Generate with: openssl rand -hex 32
# Used to secure /api/cron endpoint
# --------------------------------------------
CRON_SECRET=your-random-32-char-hex-string

# --------------------------------------------
# Optional: Analytics (Plausible, Umami, etc.)
# --------------------------------------------
# PLAUSIBLE_DOMAIN=mindspace.vercel.app
# PLAUSIBLE_API_HOST=https://plausible.io

# --------------------------------------------
# Optional: Error Tracking (Sentry)
# --------------------------------------------
# SENTRY_DSN=https://xxx@sentry.io/xxx

# --------------------------------------------
# Development Overrides (apps/web/.env only)
# --------------------------------------------
# VITE_API_URL=http://localhost:3000/api
# VITE_ENABLE_DEVTOOLS=true